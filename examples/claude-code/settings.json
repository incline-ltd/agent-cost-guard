{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/agent-cost-guard\" hook claude-code --strict",
            "timeout": 10,
            "statusMessage": "Checking cost policy"
          }
        ]
      }
    ]
  }
}
